<%
  /*
   * views/index.ejs
   * Main collection overview: filterable/searchable/sortable grid of all media items.
   */
  const pageTitle = __('collection_page_title');
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> – VinylVault</title>
  <link rel="stylesheet" href="<%= base %>/public/style.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="<%= base %>/public/themes.css?v=<%= assetVersion %>" />
  <%- include('partials/head-i18n') %>
</head>
<body>
  <header class="site-header">
    <a class="logo" href="<%= base %>/">
      <span class="logo-icon">🎵</span>
      <span class="logo-text">VinylVault</span>
    </a>
    <div class="nav-wrap">
      <nav class="nav-primary">
        <a class="btn btn-ghost nav-link-collection" href="<%= base %>/"><span class="btn-icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="2" fill="currentColor" /></svg></span><span class="btn-label"><%= __('nav_collection') %></span></a>
        <a href="<%= base %>/items/wishlist-add" class="btn btn-secondary"><span class="btn-icon">♥</span><span class="btn-label"><%= __('nav_wishlist') %></span></a>
        <a href="<%= base %>/items/add" class="btn btn-primary"><span class="btn-icon">+</span><span class="btn-label"><%= __('nav_add') %></span></a>
        <details class="nav-more nav-main">
          <summary class="nav-more-btn" aria-label="Menue">Menu</summary>
          <div class="nav-more-panel">
            <details class="nav-more-sub">
              <summary class="nav-more-sub-btn">CSV</summary>
              <div class="nav-more-sub-panel">
                <a href="<%= base %>/csv"><%= __('nav_csv_import') %></a>
                <a href="<%= base %>/csv/export"><%= __('nav_csv_export') %></a>
              </div>
            </details>
            <a href="<%= base %>/items/bulk-refresh"><%= __('nav_bulk_analysis') %></a>
            <details class="nav-more-sub">
              <summary class="nav-more-sub-btn">Theme</summary>
              <div class="nav-more-sub-panel nav-theme-panel">
                <a href="javascript:void(0)" class="theme-option" data-theme="amber">Amber</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="dark">Dark</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="forest">Forest</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="gold">Gold</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="jazz">Jazz</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="matrix">Matrix</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="midnight">Midnight</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="ocean">Ocean</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="punk">Punk</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="retro">Retro</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="ruby">Ruby</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="slate">Slate</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="sunset">Sunset</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="synthwave">Synthwave</a>
                <a href="javascript:void(0)" class="theme-option" data-theme="vinyl">Vinyl</a>
              </div>
            </details>
            <div class="nav-lang-group">
              <a href="javascript:void(0)" onclick="setLang('de')" class="lang-option<%= lang === 'de' ? ' active' : '' %>">DE</a>
              <a href="javascript:void(0)" onclick="setLang('en')" class="lang-option<%= lang === 'en' ? ' active' : '' %>">EN</a>
            </div>
          </div>
        </details>
      </nav>
    </div>
  </header>

  <main class="container">
    <h1 class="page-title"><%= __('my_collection') %></h1>

    <!-- ── Toolbar ────────────────────────────────────────────────────────── -->
    <div class="toolbar">

      <!-- Suche -->
      <div class="toolbar-search">
        <span class="toolbar-search-icon">🔍</span>
        <input
          id="search-input"
          type="search"
          placeholder="<%= __('search_placeholder') %>"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <!-- Status-Filter -->
      <div class="filter-group">
        <label for="status"><%= __('label_status') %></label>
        <select id="status-filter">
          <option value="all"      <%= selectedStatus === 'all'      ? 'selected' : '' %>><%= __('filter_all') %></option>
          <option value="owned"    <%= selectedStatus === 'owned'    ? 'selected' : '' %>><%= __('label_owned') %></option>
          <option value="wishlist" <%= selectedStatus === 'wishlist' ? 'selected' : '' %>><%= __('label_wishlist') %></option>
        </select>
      </div>

      <!-- Sortierung -->
      <div class="filter-group">
        <label for="sort-select"><%= __('label_sort') %></label>
        <select id="sort-select">
          <option value="added-desc"><%= __('sort_added') %></option>
          <option value="title-asc"><%= __('sort_title_az') %></option>
          <option value="title-desc"><%= __('sort_title_za') %></option>
          <option value="artist-asc"><%= __('sort_artist_az') %></option>
          <option value="year-asc"><%= __('sort_year_asc') %></option>
          <option value="year-desc"><%= __('sort_year_desc') %></option>
          <option value="rating-desc"><%= __('sort_rating') %></option>
        </select>
      </div>

      <!-- Ansicht + Zähler -->
      <div class="toolbar-right">
        <span class="filter-count" id="item-count"><%= __('n_records').replace('{n}', items.length) %></span>
        <div class="view-toggle" role="group" aria-label="<%= __('view_label') %>">
          <button class="view-btn active" id="view-grid"    title="<%= __('view_grid') %>">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <rect x="0" y="0" width="6" height="6" rx="1"/><rect x="10" y="0" width="6" height="6" rx="1"/>
              <rect x="0" y="10" width="6" height="6" rx="1"/><rect x="10" y="10" width="6" height="6" rx="1"/>
            </svg>
          </button>
          <button class="view-btn" id="view-list"    title="<%= __('view_list') %>">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <rect x="0" y="1" width="16" height="3" rx="1"/><rect x="0" y="7" width="16" height="3" rx="1"/>
              <rect x="0" y="13" width="16" height="3" rx="1"/>
            </svg>
          </button>
          <button class="view-btn" id="view-carousel" title="<%= __('view_carousel') %>">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <rect x="0" y="2" width="5" height="12" rx="1.5"/>
              <rect x="6" y="0" width="4" height="16" rx="1.5"/>
              <rect x="11" y="2" width="5" height="12" rx="1.5"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ── Item list / grid ───────────────────────────────────────────────── -->
    <% if (items.length === 0) { %>
      <div class="empty-state">
        <p><%= __('empty_state') %> <a href="<%= base %>/items/add"><%= __('add_now') %> &rsaquo;</a></p>
      </div>
    <% } else { %>
      <div class="select-mode-toggle">
        <button type="button" class="btn btn-ghost btn-sm" id="btn-toggle-select">☐ <%= __('select_multiple') %></button>
      </div>
      <div id="no-results" class="empty-state" style="display:none">
        <p><%= __('no_search_results') %></p>
      </div>
      <div class="carousel-wrap" id="carousel-wrap">
        <button class="carousel-arrow carousel-arrow--prev" id="carousel-prev" aria-label="<%= __('prev_btn') %>">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M12.5 4L7 10l5.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        </button>
        <ul class="item-grid" id="item-grid">
        <% for (const item of items) { %>
          <li class="item-card"
              data-id="<%= item.id %>"
              data-title="<%= (item.title  || '').toLowerCase() %>"
              data-artist="<%= (item.artist || '').toLowerCase() %>"
              data-artist-name="<%= (item.artist || '').replace(/"/g, '&quot;') %>"
              data-year="<%= item.year  || '0' %>"
              data-rating="<%= item.rating || 0 %>"
              data-status="<%= item.owned ? 'owned' : item.wishlist ? 'wishlist' : 'none' %>"
              data-added="<%= item.id %>">
            <label class="item-checkbox-wrap" aria-label="<%= __('select_label') %>">
              <input type="checkbox" class="item-checkbox" value="<%= item.id %>" tabindex="-1" />
              <span class="item-checkbox-box">✔</span>
            </label>
            <a href="<%= base %>/items/<%= item.id %>" class="item-link">
              <div class="item-cover">
                <% if (item.cover_url) { %>
                  <img src="<%= item.cover_url %>" alt="<%= item.title %>" loading="lazy" />
                <% } else { %>
                  <div class="cover-placeholder"><span>🎵</span></div>
                <% } %>
              </div>
              <div class="item-info">
                <p class="item-title"><%= item.title %></p>
                <% if (item.artist) { %><p class="item-artist"><%= item.artist %></p><% } %>
                <p class="item-meta">
                  <% if (item.year) { %><span class="item-year"><%= item.year %></span><% } %>
                  <% if (item.owned)    { %><span class="badge badge-owned">✔ <%= __('label_owned') %></span><% } %>
                  <% if (item.wishlist) { %><span class="badge badge-wish">♥ <%= __('label_wishlist_badge') %></span><% } %>
                </p>
              </div>
            </a>
            <div class="card-stars-interactive" data-id="<%= item.id %>" data-rating="<%= item.rating || 0 %>">
              <% for (let i = 1; i <= 5; i++) { %><span class="cstar <%= i <= (item.rating || 0) ? 'cstar-on' : 'cstar-off' %>" data-value="<%= i %>">★</span><% } %>
            </div>
            <% if (item.wishlist) { %>
              <a
                class="gh-link shop-link shop-link--gh"
                href="https://greenhell.de/search/?qs=<%= encodeURIComponent((item.artist ? item.artist + ' ' : '') + item.title).replace(/%20/g, '+') %>"
                target="_blank"
                rel="noopener"
                title="<%= __('shop_greenhell') %>"
              ><%= __('shop_greenhell_short') %> ↗</a>
              <a
                class="gh-link shop-link shop-link--amazon"
                href="https://www.amazon.de/s?k=<%= encodeURIComponent((item.artist ? item.artist + ' ' : '') + item.title) %>"
                target="_blank"
                rel="noopener"
                title="<%= __('shop_amazon') %>"
              ><%= __('shop_amazon_short') %> ↗</a>
            <% } %>
          </li>
        <% } %>
        </ul>
        <button class="carousel-arrow carousel-arrow--next" id="carousel-next" aria-label="<%= __('next_btn') %>">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M7.5 4L13 10l-5.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        </button>
      </div>
    <% } %>

    <!-- Hidden bulk-delete form -->
    <form id="bulk-delete-form" method="post" action="<%= base %>/items/bulk-delete" style="display:none"></form>
  </main>

  <!-- ── Sticky Bulk-Action-Bar ─────────────────────────────────────────────── -->
  <div class="bulk-action-bar" id="bulk-action-bar">
    <span class="bulk-count" id="bulk-count">0 <%= __('selected_label') %></span>
    <div class="bulk-actions">
      <button type="button" class="btn btn-ghost btn-sm" id="bulk-btn-all"><%= __('select_all') %></button>
      <button type="button" class="btn btn-ghost btn-sm" id="bulk-btn-none"><%= __('deselect_all') %></button>
      <button type="button" class="btn btn-danger btn-sm" id="bulk-btn-delete"><%= __('delete_btn') %></button>
    </div>
  </div>

  <footer class="site-footer">
    <small><%= __('footer') %></small>
  </footer>

  <script>
    const LANG = '<%= lang %>';
    const BASE      = '<%= base %>';
    const grid      = document.getElementById('item-grid');
    const bulkBar   = document.getElementById('bulk-action-bar');
    const bulkCount = document.getElementById('bulk-count');
    const btnToggle = document.getElementById('btn-toggle-select');
    const noResults = document.getElementById('no-results');
    const countEl   = document.getElementById('item-count');
    let selectMode  = false;

    // ── Ansicht ────────────────────────────────────────────────────────────
    const VIEWS = ['grid', 'list', 'carousel'];
    let currentView = localStorage.getItem('md-view') || 'grid';

    function applyView(v) {
      currentView = v;
      localStorage.setItem('md-view', v);
      VIEWS.forEach(name => {
        grid?.classList.toggle('view-' + name, name === v);
        document.getElementById('view-' + name)?.classList.toggle('active', name === v);
      });
      const wrap = document.getElementById('carousel-wrap');
      wrap?.classList.toggle('is-carousel', v === 'carousel');
      if (v === 'carousel') carouselIndex = 0;
      else clearStackStyles();
      applyFiltersAndSort();
    }

    VIEWS.forEach(v => document.getElementById('view-' + v)?.addEventListener('click', () => applyView(v)));

    // ── Plattenstapel-Karussell ("durch den Stapel blättern") ───────────────
    // Die Cover liegen wie in einer Plattenkiste hintereinander. Die vorderste
    // Karte schaut den Betrachter an; beim "Blättern" kippt sie nach vorn weg
    // und die nächste rückt auf. Tiefe/Drehung werden je Karte als Inline-Style
    // gesetzt, die CSS-transition animiert den Übergang.
    const STACK_DEPTH = 6;   // sichtbare Karten hinter der vordersten
    let carouselIndex = 0;
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    function visibleCards() {
      return grid ? [...grid.querySelectorAll('.item-card')].filter(c => c.style.display !== 'none') : [];
    }

    function applyCardStyle(card, pos) {
      let transform, opacity, filter, vis = 'visible', pointer = 'none', z;
      if (pos === 0) {
        // vorderste Karte – aufrecht und voll sichtbar
        transform = 'translate3d(0,0,0) rotateX(0deg) scale(1)';
        opacity = 1; filter = 'brightness(1)'; z = 1000; pointer = 'auto';
      } else if (pos > 0) {
        // im Stapel dahinter: jede Platte schaut oben mit einem gut sichtbaren
        // Cover-Streifen hervor – wie beim Durchblättern einer echten Plattenkiste.
        const d = pos;
        const lift  = 34 + (d - 1) * 26;   // erste dahinter weit hochschieben → Cover sichtbar
        const depth = d * 46;
        const tilt  = 4 + d * 0.9;
        const scale = Math.max(0.72, 1 - d * 0.045);
        transform = `translate3d(0, ${-lift}px, ${-depth}px) `
                  + `rotateX(${tilt}deg) scale(${scale})`;
        // nur leicht abdunkeln, damit das Cover dahinter klar erkennbar bleibt
        opacity = Math.max(0.35, 1 - d * 0.11);
        filter  = `brightness(${Math.max(0.66, 1 - d * 0.06)})`;
        z = 1000 - d;
        if (d <= STACK_DEPTH) pointer = 'auto'; else vis = 'hidden';
      } else {
        // bereits weggeblättert: kippt nach vorn zum Betrachter und blendet aus
        transform = 'translate3d(0, 52px, 210px) rotateX(-90deg) scale(1)';
        opacity = 0; filter = 'brightness(1.1)'; z = 1100 - pos;
        if (pos < -2) vis = 'hidden';
      }
      card.style.transform     = transform;
      card.style.opacity       = opacity;
      card.style.filter        = filter;
      card.style.zIndex        = z;
      card.style.visibility    = vis;
      card.style.pointerEvents = pointer;
    }

    function layoutStack() {
      const cards = visibleCards();
      if (!cards.length) return;
      carouselIndex = Math.max(0, Math.min(carouselIndex, cards.length - 1));
      cards.forEach((card, i) => {
        const pos = i - carouselIndex;
        card.classList.toggle('carousel-active', pos === 0);
        applyCardStyle(card, pos);
      });
      prevBtn?.toggleAttribute('disabled', carouselIndex <= 0);
      nextBtn?.toggleAttribute('disabled', carouselIndex >= cards.length - 1);
    }

    // Inline-Styles entfernen, wenn das Karussell verlassen wird (sonst bleiben
    // die 3D-Transforms in Grid-/Listenansicht hängen)
    function clearStackStyles() {
      allCards().forEach(c => {
        c.style.transform = c.style.opacity = c.style.filter = '';
        c.style.zIndex = c.style.visibility = c.style.pointerEvents = '';
        c.classList.remove('carousel-active');
      });
    }

    function carouselGo(delta) {
      const n = visibleCards().length;
      if (!n) return;
      carouselIndex = Math.max(0, Math.min(carouselIndex + delta, n - 1));
      layoutStack();
    }

    prevBtn?.addEventListener('click', () => carouselGo(-1));
    nextBtn?.addEventListener('click', () => carouselGo(1));

    // Eine Karte aus dem Stapel anklicken blättert nach vorn zu ihr
    document.getElementById('item-grid')?.addEventListener('click', e => {
      if (currentView !== 'carousel') return;
      const card = e.target.closest('.item-card');
      if (!card || card.classList.contains('carousel-active')) return;
      e.preventDefault();
      const idx = visibleCards().indexOf(card);
      if (idx >= 0) { carouselIndex = idx; layoutStack(); }
    });
    // Pfeiltasten blättern durch den Stapel (nicht beim Tippen in Eingabefeldern)
    document.addEventListener('keydown', e => {
      if (currentView !== 'carousel') return;
      const tag = (e.target.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'select' || tag === 'textarea') return;
      if (e.key === 'ArrowLeft')  carouselGo(-1);
      if (e.key === 'ArrowRight') carouselGo(1);
    });
    // Mausrad / Trackpad blättert ebenfalls (gedrosselt, damit nicht zu schnell)
    let wheelLock = 0;
    document.getElementById('carousel-wrap')?.addEventListener('wheel', e => {
      if (currentView !== 'carousel') return;
      e.preventDefault();
      const now = Date.now();
      if (now - wheelLock < 320) return;
      if (Math.abs(e.deltaY) < 6 && Math.abs(e.deltaX) < 6) return;
      wheelLock = now;
      carouselGo((e.deltaY + e.deltaX) > 0 ? 1 : -1);
    }, { passive: false });

    // Touch: auf dem Handy mit hoch/runter (oder links/rechts) wischen blättern.
    // Hochwischen → nächste Platte, runterwischen → vorherige.
    let touchStartX = 0, touchStartY = 0, touchActive = false;
    const carWrap = document.getElementById('carousel-wrap');
    carWrap?.addEventListener('touchstart', e => {
      if (currentView !== 'carousel' || e.touches.length !== 1) { touchActive = false; return; }
      touchActive = true;
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });
    carWrap?.addEventListener('touchmove', e => {
      // vertikales Wischen abfangen, damit die Seite nicht mitscrollt
      if (touchActive && currentView === 'carousel') e.preventDefault();
    }, { passive: false });
    carWrap?.addEventListener('touchend', e => {
      if (!touchActive || currentView !== 'carousel') return;
      touchActive = false;
      const t = e.changedTouches[0];
      const dx = t.clientX - touchStartX;
      const dy = t.clientY - touchStartY;
      // dominante Achse bestimmt die Richtung; Mindestweg gegen versehentliche Tipper
      const horizontal = Math.abs(dx) > Math.abs(dy);
      const dist = horizontal ? dx : dy;
      if (Math.abs(dist) < 30) return;
      // hoch/links wischen → nächste, runter/rechts wischen → vorherige
      carouselGo(dist < 0 ? 1 : -1);
    }, { passive: true });

    // ── Suche + Filter + Sortierung ────────────────────────────────────────
    const searchInput  = document.getElementById('search-input');
    const statusFilter = document.getElementById('status-filter');
    const sortSelect   = document.getElementById('sort-select');

    // Gespeicherte Einstellungen laden
    sortSelect.value   = localStorage.getItem('md-sort')   || 'added-desc';
    statusFilter.value = localStorage.getItem('md-status') || 'all';

    function allCards() { return grid ? [...grid.querySelectorAll('.item-card')] : []; }

    function clearGroupHeaders() {
      grid?.querySelectorAll('.item-group-header').forEach(el => el.remove());
    }

    function renderGrouped(visible, hidden, mode) {
      clearGroupHeaders();
      const frag = document.createDocumentFragment();
      let lastKey = null;
      visible.forEach(card => {
        let key = '';
        let label = '';
        if (mode === 'artist') {
          key = (card.dataset.artist || '').trim() || '~unknown';
          label = (card.dataset.artistName || '').trim() || __('unknown_artist');
        } else if (mode === 'title-letter') {
          const rawTitle = (card.dataset.title || '').trim();
          const firstChar = rawTitle ? rawTitle[0] : '#';
          const upper = firstChar.toLocaleUpperCase();
          key = /[A-ZÄÖÜ0-9]/.test(upper) ? upper : '#';
          label = key;
        } else if (mode === 'year') {
          const year = String(card.dataset.year || '').trim();
          key = year && year !== '0' ? year : '~unknown-year';
          label = year && year !== '0' ? year : __('unknown_year');
        } else if (mode === 'rating') {
          const ratingNum = Number(card.dataset.rating || 0);
          const clamped = Number.isFinite(ratingNum) ? Math.max(0, Math.min(5, ratingNum)) : 0;
          key = String(clamped);
          label = clamped > 0 ? `${clamped} ★` : __('unrated');
        }
        if (key !== lastKey) {
          const header = document.createElement('li');
          header.className = 'item-group-header';
          header.textContent = label;
          frag.appendChild(header);
          lastKey = key;
        }
        frag.appendChild(card);
      });
      grid.appendChild(frag);
      hidden.forEach(c => grid.appendChild(c));
    }

    function groupModeForSort(sort) {
      if (sort === 'artist-asc') return 'artist';
      if (sort === 'title-asc' || sort === 'title-desc') return 'title-letter';
      if (sort === 'year-asc' || sort === 'year-desc') return 'year';
      if (sort === 'rating-desc') return 'rating';
      return null;
    }

    function applyFiltersAndSort() {
      const q      = (searchInput?.value || '').toLowerCase().trim();
      const status = statusFilter.value;
      const sort   = sortSelect.value;
      const groupMode = currentView === 'carousel' ? null : groupModeForSort(sort);

      localStorage.setItem('md-sort',   sort);
      localStorage.setItem('md-status', status);

      let cards = allCards();

      // Filter
      let visibleCount = 0;
      cards.forEach(card => {
        const matchQ = !q
          || card.dataset.title.includes(q)
          || card.dataset.artist.includes(q);

        const cardStatus = card.dataset.status;
        const matchStatus = status === 'all'
          || (status === 'owned'    && cardStatus === 'owned')
          || (status === 'wishlist' && cardStatus === 'wishlist');

        const visible = matchQ && matchStatus;
        card.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      noResults && (noResults.style.display = visibleCount === 0 ? '' : 'none');
      countEl   && (countEl.textContent = __('n_records').replace('{n}', visibleCount));

      // Sortierung: nur sichtbare Karten neu anordnen
      const visible = cards.filter(c => c.style.display !== 'none');
      visible.sort((a, b) => {
        switch (sort) {
          case 'title-asc':    return a.dataset.title.localeCompare(b.dataset.title, LANG);
          case 'title-desc':   return b.dataset.title.localeCompare(a.dataset.title, LANG);
          case 'artist-asc':   return a.dataset.artist.localeCompare(b.dataset.artist, LANG);
          case 'year-asc':     return Number(a.dataset.year)  - Number(b.dataset.year);
          case 'year-desc':    return Number(b.dataset.year)  - Number(a.dataset.year);
          case 'rating-desc':  return Number(b.dataset.rating) - Number(a.dataset.rating);
          default: /* added-desc */ return Number(b.dataset.added) - Number(a.dataset.added);
        }
      });
      const hidden = cards.filter(c => c.style.display === 'none');
      if (groupMode) renderGrouped(visible, hidden, groupMode);
      else {
        clearGroupHeaders();
        visible.forEach(c => grid.appendChild(c));
        hidden.forEach(c => grid.appendChild(c));
      }

      // Im Plattenstapel nach Suche/Filter/Sortierung wieder oben beginnen
      if (currentView === 'carousel') { carouselIndex = 0; layoutStack(); }
    }

    let debounceTimer;
    searchInput?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFiltersAndSort, 150);
    });
    statusFilter?.addEventListener('change', applyFiltersAndSort);
    sortSelect?.addEventListener('change', applyFiltersAndSort);

    applyView(currentView);

    // ── Mehrfachauswahl ────────────────────────────────────────────────────
    function checkboxes() { return grid ? [...grid.querySelectorAll('.item-checkbox')] : []; }
    function selected()   { return checkboxes().filter(c => c.checked); }

    function updateBar() {
      const n = selected().length;
      bulkCount.textContent = __('n_selected').replace('{n}', n);
      bulkBar.classList.toggle('visible', selectMode && n > 0);
    }

    function setSelectMode(on) {
      selectMode = on;
      document.body.classList.toggle('selection-mode', on);
      btnToggle.textContent = on ? '✕ ' + __('end_selection') : '☐ ' + __('select_multiple');
      if (!on) {
        checkboxes().forEach(c => { c.checked = false; c.closest('.item-card').classList.remove('selected'); });
        bulkBar.classList.remove('visible');
      }
    }

    btnToggle?.addEventListener('click', () => setSelectMode(!selectMode));

    grid?.addEventListener('click', e => {
      if (!selectMode) return;
      const card = e.target.closest('.item-card');
      if (!card) return;
      if (!e.target.closest('.item-checkbox-wrap') && !e.target.closest('.shop-link')) {
        e.preventDefault();
        const cb = card.querySelector('.item-checkbox');
        cb.checked = !cb.checked;
        card.classList.toggle('selected', cb.checked);
        updateBar();
      } else if (e.target.closest('.item-checkbox-wrap')) {
        setTimeout(() => {
          const cb = card.querySelector('.item-checkbox');
          card.classList.toggle('selected', cb.checked);
          updateBar();
        }, 0);
      }
    });

    document.getElementById('bulk-btn-all')?.addEventListener('click', () => {
      checkboxes().forEach(c => { c.checked = true; c.closest('.item-card').classList.add('selected'); });
      updateBar();
    });
    document.getElementById('bulk-btn-none')?.addEventListener('click', () => {
      checkboxes().forEach(c => { c.checked = false; c.closest('.item-card').classList.remove('selected'); });
      updateBar();
    });
    document.getElementById('bulk-btn-delete')?.addEventListener('click', () => {
      const ids = selected().map(c => c.value);
      if (!ids.length) return;
      if (!confirm(__('confirm_delete_n').replace('{n}', ids.length))) return;
      const form = document.getElementById('bulk-delete-form');
      form.querySelectorAll('input').forEach(i => i.remove());
      ids.forEach(id => {
        const inp = document.createElement('input');
        inp.type = 'hidden'; inp.name = 'ids'; inp.value = id;
        form.appendChild(inp);
      });
      form.submit();
    });

    // ── Sterne-Bewertung (Übersicht) ──────────────────────────────────────
    document.querySelectorAll('.card-stars-interactive').forEach(widget => {
      const stars = widget.querySelectorAll('.cstar');
      let cur = Number(widget.dataset.rating);

      function render(n) {
        stars.forEach((s, i) => {
          s.classList.toggle('cstar-on',  i < n);
          s.classList.toggle('cstar-off', i >= n);
        });
      }

      stars.forEach((star, idx) => {
        star.addEventListener('mouseenter', () => render(idx + 1));
        star.addEventListener('click', async e => {
          e.stopPropagation();
          const newRating = (idx + 1 === cur) ? 0 : idx + 1;
          try {
            const resp = await fetch(`${BASE}/items/${widget.dataset.id}/rating`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ rating: newRating }),
            });
            if (resp.ok) {
              cur = newRating;
              widget.dataset.rating = newRating;
              widget.closest('.item-card').dataset.rating = newRating;
              render(cur);
            }
          } catch (err) {
            console.error(__('rating_failed'), err);
          }
        });
      });

      widget.addEventListener('mouseleave', () => render(cur));
    });
  </script>
  <script src="<%= base %>/public/theme-selector.js?v=<%= assetVersion %>"></script>
</body>
</html>
